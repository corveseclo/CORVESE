<div class="custom-products-section">
  <div class="products-carousel-wrapper">
    <!-- NAVIGATION ARROW: LEFT -->
    <button type="button" class="prod-nav-btn prev-btn" id="prodPrev-{{ section.id }}" aria-label="Previous products">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    <!-- CAROUSEL TRACK -->
    <div class="products-carousel-track" id="prodTrack-{{ section.id }}">
      {% assign featured_collection = section.settings.collection %}
      
      {% if featured_collection != blank and featured_collection.products.size > 0 %}
        {% for product in featured_collection.products limit: 12 %}
          <div class="product-card">
            <a href="{{ product.url }}" class="product-card-link">
              <div class="product-image-box">
                {% if product.compare_at_price > product.price %}
                  {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                  <div class="product-badge">Save {{ discount }}%</div>
                {% endif %}
                <img 
                  src="{{ product.featured_image | image_url: width: 800 }}" 
                  alt="{{ product.title | escape }}" 
                  width="800" 
                  height="1000" 
                  class="product-image" 
                  loading="lazy"
                >
              </div>
              <div class="product-info-box">
                <div class="product-vendor">{{ product.vendor | default: "COLESICE" }}</div>
                <div class="product-title">{{ product.title }}</div>
                <div class="product-price-row">
                  <span class="price-current">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="price-compare">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      {% else %}
        <!-- PLACEHOLDER CARDS WHEN NO COLLECTION SELECTED -->
        {% for i in (1..6) %}
          <div class="product-card">
            <a href="#" class="product-card-link">
              <div class="product-image-box">
                <div class="product-badge">Save 53%</div>
                <img src="https://cdn.shopify.com/s/files/1/1082/5262/7281/files/hf_20260820_140343_cc84bd82-e7ce-42ef-9e4e-92ecc48a8d52.webp?v=1789745428" alt="Product" width="800" height="1000" class="product-image" loading="lazy">
              </div>
              <div class="product-info-box">
                <div class="product-vendor">COLESICE</div>
                <div class="product-title">COLESICE MIDNIGHT TRACKSUIT</div>
                <div class="product-price-row">
                  <span class="price-current">£75.00</span>
                  <span class="price-compare">£158.00</span>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- NAVIGATION ARROW: RIGHT -->
    <button type="button" class="prod-nav-btn next-btn" id="prodNext-{{ section.id }}" aria-label="Next products">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</div>

{% stylesheet %}
.custom-products-section {
  width: 100%;
  background-color: #000000;
  padding: 20px 0;
  box-sizing: border-box;
}

.products-carousel-wrapper {
  position: relative;
  width: 100%;
  padding: 0 45px; /* Side room for navigation arrows */
  box-sizing: border-box;
}

.products-carousel-track {
  display: flex;
  gap: 12px; /* Matches gap distance between cards */
  overflow-x: auto;
  scroll-behavior: smooth;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE/Edge */
}

.products-carousel-track::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

/* Calculate width so EXACTLY 3 cards fill screen width minus gaps */
.product-card {
  flex: 0 0 calc((100% - 24px) / 3);
  max-width: calc((100% - 24px) / 3);
  box-sizing: border-box;
  background-color: #2b2b2b;
}

.product-card-link {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  width: 100%;
  height: 100%;
}

.product-image-box {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 4.8; /* Taller height aspect ratio to match Upload 1 */
  background-color: #ffffff;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.product-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background-color: #e60000;
  color: #ffffff;
  font-size: 0.7rem;
  font-weight: 800;
  padding: 3px 6px;
  border-radius: 1px;
  z-index: 2;
  text-transform: uppercase;
}

.product-info-box {
  background-color: #2b2b2b; /* Dark grey container footer */
  padding: 16px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 4px;
}

.product-vendor {
  color: #888888;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.product-title {
  color: #ffffff;
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  line-height: 1.2;
}

.product-price-row {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-top: 2px;
}

.price-current {
  color: #ff3b30; /* Red price accent */
  font-size: 0.82rem;
  font-weight: 700;
}

.price-compare {
  color: #888888;
  font-size: 0.82rem;
  font-weight: 500;
  text-decoration: line-through;
}

/* ARROW BUTTONS: Black circle with white arrow centered */
.prod-nav-btn {
  position: absolute;
  top: 45%;
  transform: translateY(-50%);
  width: 38px;
  height: 38px;
  background-color: #000000;
  border: 1px solid #333333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  padding: 0;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.prod-nav-btn:hover {
  border-color: #ffffff;
  background-color: #111111;
}

.prod-nav-btn.prev-btn {
  left: 6px;
}

.prod-nav-btn.next-btn {
  right: 6px;
}

@media screen and (max-width: 989px) {
  .product-card {
    flex: 0 0 calc((100% - 12px) / 2);
    max-width: calc((100% - 12px) / 2);
  }
}

@media screen and (max-width: 600px) {
  .products-carousel-wrapper {
    padding: 0 35px;
  }
  .product-card {
    flex: 0 0 100%;
    max-width: 100%;
  }
}
{% endstylesheet %}

<script>
  (function() {
    function initProductCarousel() {
      const sectionId = "{{ section.id }}";
      const track = document.getElementById('prodTrack-' + sectionId);
      const prevBtn = document.getElementById('prodPrev-' + sectionId);
      const nextBtn = document.getElementById('prodNext-' + sectionId);

      if (!track || !prevBtn || !nextBtn) return;

      prevBtn.addEventListener('click', function() {
        const cardWidth = track.querySelector('.product-card')?.offsetWidth || 300;
        track.scrollBy({ left: -(cardWidth + 12), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', function() {
        const cardWidth = track.querySelector('.product-card')?.offsetWidth || 300;
        track.scrollBy({ left: cardWidth + 12, behavior: 'smooth' });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductCarousel);
    } else {
      initProductCarousel();
    }
  })();
</script>

{% schema %}
{
  "name": "Custom Featured Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Products"
    }
  ]
}
{% endschema %}