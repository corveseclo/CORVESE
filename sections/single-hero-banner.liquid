<div class="single-hero-wrapper">
  <a href="#" class="single-hero-card">
    <img 
      src="https://cdn.shopify.com/s/files/1/1082/5262/7281/files/hf_20260820_140343_cc84bd82-e7ce-42ef-9e4e-92ecc48a8d52.webp?v=1789745428" 
      alt="FALL/WINTER 26’" 
      width="1600"
      height="1000"
      class="single-hero-img"
      loading="lazy"
    >
    <div class="single-hero-overlay">
      <div class="single-hero-title">FALL/WINTER 26’</div>
    </div>
  </a>
</div>

{% stylesheet %}
.single-hero-wrapper {
  width: 100%;
  background-color: #000000;
  padding: 0 6px;
  box-sizing: border-box;
}

.single-hero-card {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  display: block;
  text-decoration: none;
  background-color: #111111;
}

.single-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

.single-hero-card:hover .single-hero-img {
  transform: scale(1.01);
}

.single-hero-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding-bottom: 75px; /* Shifted higher up than standard bottom position */
  z-index: 2;
  pointer-events: none;
}

.single-hero-title {
  color: #ffffff;
  font-size: 1.4rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-align: center;
  font-family: inherit;
  text-shadow: 0px 2px 10px rgba(0, 0, 0, 0.4);
}

@media screen and (max-width: 749px) {
  .single-hero-wrapper {
    padding: 0 4px;
  }
  .single-hero-card {
    aspect-ratio: 4 / 5;
  }
  .single-hero-overlay {
    padding-bottom: 50px;
  }
  .single-hero-title {
    font-size: 1.1rem;
  }
}
{% endstylesheet %}

