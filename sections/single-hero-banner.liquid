<div class="single-hero-wrapper">
  <a href="#" class="single-hero-card">
    <img 
      src="https://cdn.shopify.com/s/files/1/1082/5262/7281/files/hf_20260820_140343_cc84bd82-e7ce-42ef-9e4e-92ecc48a8d52.webp?v=1789745428" 
      alt="FALL/WINTER 26’" 
      width="1600"
      height="1000"
      class="single-hero-img"
      loading="lazy"
    >
    <div class="single-hero-overlay">
      <div class="single-hero-title">FALL/WINTER 26’</div>
    </div>
  </a>
</div>

{% stylesheet %}
.single-hero-wrapper {
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  margin-top: 16px;
  margin-bottom: 16px;
  background-color: #000000;
  box-sizing: border-box;
}

.single-hero-card {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  display: block;
  text-decoration: none;
  background-color: #111111;
}

.single-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.single-hero-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding-bottom: 60px;
  z-index: 2;
  pointer-events: none;
}

.single-hero-title {
  color: #ffffff;
  font-family: inherit; /* Matches exact theme font used in timer code */
  font-size: 2.42rem;   /* Increased font size by 10% */
  font-weight: 900;     /* Heavy bold matching timer heading */
  letter-spacing: -0.01em;
  text-transform: uppercase;
  text-align: center;
  line-height: 1;
  text-shadow: 0px 2px 12px rgba(0, 0, 0, 0.5);
}

@media screen and (max-width: 749px) {
  .single-hero-wrapper {
    margin-top: 12px;
    margin-bottom: 12px;
  }
  .single-hero-card {
    aspect-ratio: 4 / 5;
  }
  .single-hero-overlay {
    padding-bottom: 40px;
  }
  .single-hero-title {
    font-size: 1.65rem; /* Increased mobile size by 10% */
  }
}
{% endstylesheet %}

