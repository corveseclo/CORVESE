{% stylesheet %}
.reviews-section-wrapper {
  width: 100%;
  background-color: #000000;
  padding: 50px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.reviews-carousel {
  width: 100%;
  max-width: 700px;
  position: relative;
  min-height: 530px;
}

.review-slide {
  display: none;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.review-slide.active {
  display: flex;
}

.review-stars {
  color: #d4af37;
  font-size: 1.4rem;
  letter-spacing: 4px;
  margin-bottom: 20px;
}

.review-quote-text {
  color: #ffffff;
  font-size: 1.5rem;
  font-weight: 800;
  line-height: 1.3;
  margin-bottom: 25px;
  max-width: 620px;
  font-family: inherit;
}

/* Larger grey quotation marks */
.quote-mark {
  color: #555555;
  font-size: 2.8rem;
  font-weight: 900;
  vertical-align: sub;
  line-height: 0;
  padding: 0 4px;
}

.review-image-container {
  width: 280px;
  aspect-ratio: 2 / 3;
  background-color: #111111;
  overflow: hidden;
  margin-bottom: 12px;
}

.review-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.review-author {
  color: #888888;
  font-size: 0.95rem;
  font-weight: 500;
  margin-bottom: 30px;
}

/* NAVIGATION & DOTS */
.reviews-navigation {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-top: 10px;
}

.nav-arrow {
  background: transparent;
  border: 1px solid #333333;
  color: #ffffff;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 0;
  transition: border-color 0.2s ease;
}

.nav-arrow svg {
  display: block;
}

.nav-arrow:hover {
  border-color: #ffffff;
}

.dots-container {
  display: flex;
  gap: 10px;
  align-items: center;
}

.dot {
  width: 6px;
  height: 6px;
  background-color: #444444;
  border-radius: 50%;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.dot.active {
  background-color: #ffffff;
}

@media screen and (max-width: 749px) {
  .review-quote-text {
    font-size: 1.2rem;
  }
  .quote-mark {
    font-size: 2.2rem;
  }
  .review-image-container {
    width: 220px;
  }
}
{% endstylesheet %}

<script>
  (function() {
    function initReviews() {
      const sectionId = "{{ section.id }}";
      const carousel = document.getElementById('ReviewsCarousel-' + sectionId);
      if (!carousel) return;

      const slides = carousel.querySelectorAll('.review-slide');
      const dots = document.querySelectorAll('#dotsContainer-' + sectionId + ' .dot');
      const prevBtn = document.getElementById('prevBtn-' + sectionId);
      const nextBtn = document.getElementById('nextBtn-' + sectionId);
      let currentIndex = 0;

      function showSlide(index) {
        if (index < 0) {
          currentIndex = slides.length - 1;
        } else if (index >= slides.length) {
          currentIndex = 0;
        } else {
          currentIndex = index;
        }

        slides.forEach((slide, i) => {
          slide.classList.toggle('active', i === currentIndex);
        });

        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === currentIndex);
        });
      }

      if (prevBtn) {
        prevBtn.onclick = function() {
          showSlide(currentIndex - 1);
        };
      }

      if (nextBtn) {
        nextBtn.onclick = function() {
          showSlide(currentIndex + 1);
        };
      }

      dots.forEach(dot => {
        dot.onclick = function() {
          const index = parseInt(this.getAttribute('data-index'));
          showSlide(index);
        };
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReviews);
    } else {
      initReviews();
    }
  })();
</script>

