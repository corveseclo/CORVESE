{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}; overflow: hidden; padding-left: 0; padding-right: 0;"
>
  <div style="overflow: hidden; white-space: nowrap; width: 100%; display: flex; align-items: center;">
    <div class="marquee-track" style="display: flex; align-items: center; flex-shrink: 0; animation: marquee-scroll 28s linear infinite; white-space: nowrap;">
      <span style="display: inline-flex; align-items: center; color: #ffffff !important; font-weight: 600; letter-spacing: 0.05em; padding: 0 15px; font-size: 14px;">50% OFF SALE ENDS NEXT WEEK - FREE WORLDWIDE SHIPPING <span style="display: inline-block; width: 6px; height: 6px; background-color: #ffffff; border-radius: 50%; margin-left: 30px;"></span></span>
      <span style="display: inline-flex; align-items: center; color: #ffffff !important; font-weight: 600; letter-spacing: 0.05em; padding: 0 15px; font-size: 14px;">50% OFF SALE ENDS NEXT WEEK - FREE WORLDWIDE SHIPPING <span style="display: inline-block; width: 6px; height: 6px; background-color: #ffffff; border-radius: 50%; margin-left: 30px;"></span></span>
      <span style="display: inline-flex; align-items: center; color: #ffffff !important; font-weight: 600; letter-spacing: 0.05em; padding: 0 15px; font-size: 14px;">50% OFF SALE ENDS NEXT WEEK - FREE WORLDWIDE SHIPPING <span style="display: inline-block; width: 6px; height: 6px; background-color: #ffffff; border-radius: 50%; margin-left: 30px;"></span></span>
      <span style="display: inline-flex; align-items: center; color: #ffffff !important; font-weight: 600; letter-spacing: 0.05em; padding: 0 15px; font-size: 14px;">50% OFF SALE ENDS NEXT WEEK - FREE WORLDWIDE SHIPPING <span style="display: inline-block; width: 6px; height: 6px; background-color: #ffffff; border-radius: 50%; margin-left: 30px;"></span></span>
    </div>
    <div class="marquee-track" aria-hidden="true" style="display: flex; align-items: center; flex-shrink: 0; animation: marquee-scroll 28s linear infinite; white-space: nowrap;">
      <span style="display: inline-flex; align-items: center; color: #ffffff !important; font-weight: 600; letter-spacing: 0.05em; padding: 0 15px; font-size: 14px;">50% OFF SALE ENDS NEXT WEEK - FREE WORLDWIDE SHIPPING <span style="display: inline-block; width: 6px; height: 6px; background-color: #ffffff; border-radius: 50%; margin-left: 30px;"></span></span>
      <span style="display: inline-flex; align-items: center; color: #ffffff !important; font-weight: 600; letter-spacing: 0.05em; padding: 0 15px; font-size: 14px;">50% OFF SALE ENDS NEXT WEEK - FREE WORLDWIDE SHIPPING <span style="display: inline-block; width: 6px; height: 6px; background-color: #ffffff; border-radius: 50%; margin-left: 30px;"></span></span>
      <span style="display: inline-flex; align-items: center; color: #ffffff !important; font-weight: 600; letter-spacing: 0.05em; padding: 0 15px; font-size: 14px;">50% OFF SALE ENDS NEXT WEEK - FREE WORLDWIDE SHIPPING <span style="display: inline-block; width: 6px; height: 6px; background-color: #ffffff; border-radius: 50%; margin-left: 30px;"></span></span>
      <span style="display: inline-flex; align-items: center; color: #ffffff !important; font-weight: 600; letter-spacing: 0.05em; padding: 0 15px; font-size: 14px;">50% OFF SALE ENDS NEXT WEEK - FREE WORLDWIDE SHIPPING <span style="display: inline-block; width: 6px; height: 6px; background-color: #ffffff; border-radius: 50%; margin-left: 30px;"></span></span>
    </div>
  </div>
</aside>

<style>
@keyframes marquee-scroll {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-100%);
  }
}
</style>

{% schema %}
{
  "name": "t:names.announcement_bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar"
    }
  ]
}
{% endschema %}