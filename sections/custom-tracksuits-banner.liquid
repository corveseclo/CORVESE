{% stylesheet %}
.custom-grid-wrapper {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px; /* Consistent black gap in the center and between rows */
  box-sizing: border-box;
}

.custom-grid-col {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.custom-grid-left {
  gap: 12px; /* Same black gap distance between Hoodies and Fall/Winter */
}

.custom-card {
  position: relative;
  width: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  background-color: #000000;
}

/* Reduced height rectangular Hoodies card */
.custom-card-hoodies {
  height: 38%;
  flex-shrink: 0;
}

/* Fall/Winter stretches to fill the remaining height so the bottom lines up perfectly */
.custom-card-fw {
  flex: 1;
  min-height: 0;
}

/* Tracksuits card fills full height of right column */
.custom-card-tracksuits {
  height: 100%;
  aspect-ratio: 4 / 5;
}

.custom-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.custom-card-overlay {
  position: absolute;
  inset: 0;
  background-color: #00000040;
  z-index: 1;
}

/* Bolder text with zero letter spacing */
.custom-card-title {
  position: absolute;
  z-index: 2;
  color: #ffffff;
  font-size: 2.3rem;
  font-weight: 900;
  letter-spacing: 0px;
  text-transform: uppercase;
  text-align: center;
}

@media screen and (max-width: 749px) {
  .custom-grid-wrapper {
    grid-template-columns: 1fr;
    gap: 8px;
  }
  .custom-grid-left {
    gap: 8px;
  }
  .custom-card-hoodies {
    height: auto;
    aspect-ratio: 16 / 9;
  }
  .custom-card-title {
    font-size: 1.5rem;
  }
}
{% endstylesheet %}

